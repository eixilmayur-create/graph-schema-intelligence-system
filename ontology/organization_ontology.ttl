@prefix ex: <http://example.org/gsis/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Employee a owl:Class .
ex:Department a owl:Class .
ex:Location a owl:Class .
ex:JobRole a owl:Class .
ex:Organization a owl:Class .

ex:employeeId a owl:DatatypeProperty ;
    rdfs:domain ex:Employee ;
    rdfs:range xsd:string .

ex:fullName a owl:DatatypeProperty ;
    rdfs:domain ex:Employee ;
    rdfs:range xsd:string .

ex:email a owl:DatatypeProperty ;
    rdfs:domain ex:Employee ;
    rdfs:range xsd:string .

ex:worksIn a owl:ObjectProperty ;
    rdfs:domain ex:Employee ;
    rdfs:range ex:Department .

ex:reportsTo a owl:ObjectProperty ;
    rdfs:domain ex:Employee ;
    rdfs:range ex:Employee .

ex:locatedIn a owl:ObjectProperty ;
    rdfs:domain ex:Employee ;
    rdfs:range ex:Location .

ex:hasRole a owl:ObjectProperty ;
    rdfs:domain ex:Employee ;
    rdfs:range ex:JobRole .

ex:partOf a owl:ObjectProperty ;
    rdfs:domain ex:Department ;
    rdfs:range ex:Organization .
